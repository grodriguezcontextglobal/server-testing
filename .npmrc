# ── Registry ────────────────────────────────────────────────────────────────
# Only allow packages from the official npm registry.
# Rejects git URLs, arbitrary HTTP, local path replacements.
registry=https://registry.npmjs.org/

# ── Version pinning ──────────────────────────────────────────────────────────
# Every new install saves exact versions (no ^ or ~).
save-exact=true

# ── Engine enforcement ───────────────────────────────────────────────────────
# Fail if Node version doesn't satisfy package.json "engines".
engine-strict=true

# ── Supply chain: minimum release age (pnpm only) ───────────────────────────
# Reject packages published within the last 24 hours.
# Value is in seconds: 86400 = 24 hours.
# Most malicious supply-chain packages are detected and pulled within hours.
minimum-release-age=86400

# ── Supply chain: allowed package sources ───────────────────────────────────
# Reject direct git: / http: / file: / path: dependencies.
# Only packages from the registry above are allowed.
# Disabled by default to allow existing deps — enable after auditing all deps.
# reject-unauthorized=true

# ── Lifecycle scripts ────────────────────────────────────────────────────────
# Audit mode: warn about packages that run lifecycle scripts (preinstall, postinstall, prepare).
# Use this to review which packages need elevated trust.
# Full block: ignore-scripts=true  (breaks native modules like bcrypt, canvas — audit first)

# ── Audit & telemetry ────────────────────────────────────────────────────────
audit=true
fund=false

# ── Lock file ────────────────────────────────────────────────────────────────
# Never auto-update the lock file in CI — fail if it's out of sync.
# Set via CI command: pnpm install --frozen-lockfile
# frozen-lockfile=true  # keep off locally; enforce in CI only

# ── Peer dependencies ────────────────────────────────────────────────────────
# Warn but don't fail on unresolved peer deps (strict breaks some legacy packages).
strict-peer-dependencies=false
auto-install-peers=true

# ── Store ────────────────────────────────────────────────────────────────────
# Use the default global pnpm store (content-addressable, shared across projects).
# No action needed — pnpm handles this automatically.
