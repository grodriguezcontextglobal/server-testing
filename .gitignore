DBConexion.txt
tmp/uploads/
# .env

# Go Binaries
*.exe
*.test
*.prof
go-worker/processor
go-worker/worker
isolate-*-v8.log

logs/
.vscode/
go-worker/*.exe
go-worker/*.exe~
mysql/env.txt
payload.json

# never commit real secrets
.env
.env.backup
# Copias con fecha, que es como se hacen de verdad antes de tocar el archivo.
# El 2026-11-17 la VM de producción tenía un `.env.bak-20261116-0927` sin
# seguimiento en la carpeta del repo: `.env.backup` no lo cubría, así que un
# `git add .` lo habría commiteado con las credenciales dentro.
.env.bak*
.env.*.bak
.env.old
.env.save
.env.local

# pnpm is not used in production (npm/pm2-runtime is) — don't let a stray
# `pnpm install`/`pnpm test` reintroduce these
pnpm-lock.yaml
pnpm-workspace.yaml

# PM2_HOME points inside the repo on the production box (see DEPLOY.md), so pm2's
# runtime data lives here. It is per-machine state, never source.
.pm2/

# Herramientas locales y artefactos de sesión: se regeneran por máquina, no son
# parte del servidor.
.claude/
.atl/
graphify-out/

# Volcados y adjuntos sueltos que quedan en la raíz al depurar/reportar.
diff.txt
Server_Updates_June2026.pptx
