# Payments security policy
PAYMENTS_DUAL_LANE_ENABLED=true
PAYMENTS_MONITOR_MODE=false
PUBLIC_PAYMENTS_WINDOW_MS=300000
PUBLIC_PAYMENTS_CREATE_LIMIT=30
AUTH_PAYMENTS_CREATE_LIMIT=120
PUBLIC_PAYMENTS_MUTATION_LIMIT=10
PAYMENTS_MUTATION_IDEMPOTENCY_TTL_MS=600000

# Access control for /api/nodemailer/*  (middlewares/notificationAuth.js)
#   enforce answer 401 unless the caller has a valid session. The four pre-login
#           routes (password reset, force-logout, consumer account confirmation
#           and consumer login link) stay open in every mode.
#   warn    log unauthenticated sends, block nothing.
#   off     disable the check entirely — a rollback that needs no deploy.
# Brand spoofing is closed in all three modes: branding always comes from the
# verified session, never from the x-company-id header.
#
# NOTE for a new environment that already has traffic: app.devitrak.net calls
# this API and its source is not in this repo, so which routes it uses is not
# known here. Starting straight on enforce will refuse anything it sends that
# is not one of the four pre-login routes, and the failure is silent from the
# caller's side. If that applies to you, run `warn` for a day first, read the
# "nodemailer: unauthenticated notification allowed" lines, then come back to
# enforce. The code default is `warn` for exactly that reason; this file is the
# target state.
NODEMAILER_AUTH_MODE=enforce
