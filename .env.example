# Payments security policy
PAYMENTS_DUAL_LANE_ENABLED=true
PAYMENTS_MONITOR_MODE=false
PUBLIC_PAYMENTS_WINDOW_MS=300000
PUBLIC_PAYMENTS_CREATE_LIMIT=30
AUTH_PAYMENTS_CREATE_LIMIT=120
PUBLIC_PAYMENTS_MUTATION_LIMIT=10
PAYMENTS_MUTATION_IDEMPOTENCY_TTL_MS=600000
# Vida de una RESERVA sin respuesta. Corta a proposito: si el proceso muere
# entre reservar y responder, el reintento legitimo no debe esperar los 10 min
# de la respuesta guardada.
PAYMENTS_MUTATION_IDEMPOTENCY_INFLIGHT_TTL_MS=30000
# auto  usa Redis si REDIS_HOST/REDIS_PASSWORD estan definidos (lo correcto en
#       produccion: el cluster son varios procesos y el store tiene que ser
#       comun). memory fuerza el Map por proceso, solo para tests locales.
PAYMENTS_MUTATION_IDEMPOTENCY_STORE=auto

# Access control for /api/nodemailer/*  (middlewares/notificationAuth.js)
#   enforce answer 401 unless the caller has a valid session. The four pre-login
#           routes (password reset, force-logout, consumer account confirmation
#           and consumer login link) stay open in every mode.
#   warn    log unauthenticated sends, block nothing.
#   off     disable the check entirely — a rollback that needs no deploy.
# Brand spoofing is closed in all three modes: branding always comes from the
# verified session, never from the x-company-id header.
#
# NOTE for a new environment that already has traffic: app.devitrak.net calls
# this API and its source is not in this repo, so which routes it uses is not
# known here. Starting straight on enforce will refuse anything it sends that
# is not one of the four pre-login routes, and the failure is silent from the
# caller's side. If that applies to you, run `warn` for a day first, read the
# "nodemailer: unauthenticated notification allowed" lines, then come back to
# enforce. The code default is `warn`, so an environment deployed without this
# variable observes rather than refuses; this file is the target state, set
# deliberately.
NODEMAILER_AUTH_MODE=enforce

# Access control for /api/company/* (the Mongo company namespace). Same three
# modes as above, same default of `warn` in code:
#   enforce  401 to a caller with no valid session, except PUBLIC_ROUTES.
#   warn     log unauthenticated calls, block nothing.
#   off      disable the check entirely.
#
# Of the 18 routes in routes/company.js exactly ONE has ever checked anything,
# and the rest are not read-only: POST /provider-upload-document/:id uploads
# the posted file to S3 and pushes a record into Mongo, POST /new creates a
# company. So the target state is enforce.
#
# It is deliberately NOT set to enforce here yet, unlike the variable above.
# The client apps are not in this workspace, so which of those routes run
# before a session exists is unknown, and the exemption list in
# middlewares/companyAuth.js is seeded from route names, not from evidence.
# Run `warn` for a few days, read the "company: unauthenticated request
# allowed" lines, move anything legitimate into PUBLIC_ROUTES, and only then
# set enforce. Flipping it blind is how POST /api/db_company/delete-bulk-items
# spent three weeks answering 403 to a real user flow.
COMPANY_AUTH_MODE=warn

# Signed one-use email link for the dashboard's public /display-contracts page
# (consumer contract signing). off | warn | enforce — see
# middlewares/contractLinkAuth.js. Ship `warn`: emails sent before the deploy
# carry no token and must keep working. Switch to `enforce` 5 days after the
# deploy (the token's maximum life), once the dashboard sends `x-link-token`.
CONTRACT_LINK_MODE=warn

# Event invitations (/attendance-confirmation). off | warn | enforce — see
# middlewares/attendanceLinkAuth.js and controller/eventInvitation.js. In
# enforce, POST /api/school/event-invitations/response needs the link token and
# the generic consumer routes (POST /auth/new, PATCH /auth/:id,
# POST /auth/user-query, POST /db_consumer/new_consumer) refuse calls from the
# dashboard origin without a staff session. The consumer app is never affected.
# Switch 5 days after the dashboard ships the /send + /confirm flow.
ATTENDANCE_LINK_MODE=warn

# Anonymous GET /api/transaction/transaction (the dashboard's public /receipt page
# before receipts carried a signed token). warn | enforce — see routes/transaction.js.
# Ship `warn`: receipts already printed have a QR without token. Switch to `enforce`
# once the dashboard prints the signed QR (POST /api/transaction/receipt-link) and
# the receipts printed before that are no longer expected to be scanned.
RECEIPT_PUBLIC_READ_MODE=warn

# Runtime mode. Read by `process.env.NODE_ENV === "production"` checks; there is
# no default anywhere in the code, so leaving it unset is not "neutral" — it is
# the same as declaring the box non-production, and every one of those checks
# takes its development branch.
#
# What is currently gated on it, and what unset means on a production box:
#   controller/admin.js:64   session cookie `secure` flag -> false, so the JWT
#                            cookie is allowed over plain HTTP. IIS terminates
#                            TLS in front of Node, so the browser leg is still
#                            HTTPS; what is lost is the browser's refusal to
#                            ever replay that cookie on an http:// URL.
#   controller/admin.js:874  same flag on the logout/clear cookie.
#   helpers/logger.js:68     the winston Console transport stays attached, so
#                            every log line is also written to the nssm stdout
#                            file on top of logs/*.log.
#
# Setting it to `production` is NOT enough on its own: dotenv does not override
# a variable already present in the real environment, but the reverse is also
# true — a value here is only picked up by processes that actually read this
# repo's .env. On the production box the variable must be set on the Windows
# services themselves via `nssm set <service> AppEnvironmentExtra`, for all four
# Node services, not just the API. See DEPLOY.md, "NODE_ENV must be set on every
# Node service".
NODE_ENV=production
