PORT=
# Interface Node listens on. Default 127.0.0.1 (behind IIS). Containers: 0.0.0.0
BIND_HOST=
DB_CNN=
DB_TESTING_CNN=
DB_TESTING_NEW_CNN=
DB_AUTHENTICATION_CNN=
DB_INVENTORY_CNN=
SECRET_JWT_SEED=
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
SENDGRID_API_KEY=
SENDGRID_API_KEY_LIMITED=
SENDGRID_RECOVERY_CODE=
SENDGRID_API_KEY_PAID=
SENDGRID_API_KEY_TEST=
SENDGRID_API_KEY_LIMITED=
PLANETSCALE_DATABASE_HOST=
PLANETSCALE_DATABASE_USERNAME=
PLANETSCALE_DATABASE_PASSWORD=
PLANETSCALE_DATABASE_NAME=
PLANETSCALE_DATABASE_LIMIT=
PLANETSCALE_DATABASE_PORT=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
TURNSTILE_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
INVENTORY_IMPORT_WEBHOOK_URL=
callbackUrl_WEBHOOK_URL_SUCCESS=
callbackUrl_WEBHOOK_URL_FAIL=
GO_WORKER_PORT=
# Interface the Go worker listens on. Default 127.0.0.1; 0.0.0.0 only if Node is on another host
GO_WORKER_BIND=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Payments security policy
PAYMENTS_DUAL_LANE_ENABLED=true
PAYMENTS_MONITOR_MODE=false
PUBLIC_PAYMENTS_WINDOW_MS=300000
PUBLIC_PAYMENTS_CREATE_LIMIT=30
AUTH_PAYMENTS_CREATE_LIMIT=120
PUBLIC_PAYMENTS_MUTATION_LIMIT=10
PAYMENTS_MUTATION_IDEMPOTENCY_TTL_MS=600000
# Vida de una RESERVA sin respuesta. Corta a proposito: si el proceso muere
# entre reservar y responder, el reintento legitimo no debe esperar los 10 min
# de la respuesta guardada.
PAYMENTS_MUTATION_IDEMPOTENCY_INFLIGHT_TTL_MS=30000
# auto  usa Redis si REDIS_HOST/REDIS_PASSWORD estan definidos (lo correcto en
#       produccion: el cluster son varios procesos y el store tiene que ser
#       comun). memory fuerza el Map por proceso, solo para tests locales.
PAYMENTS_MUTATION_IDEMPOTENCY_STORE=auto

# Access control for /api/nodemailer/*  (middlewares/notificationAuth.js)
#   enforce answer 401 unless the caller has a valid session. The four pre-login
#           routes (password reset, force-logout, consumer account confirmation
#           and consumer login link) stay open in every mode.
#   warn    log unauthenticated sends, block nothing.
#   off     disable the check entirely — a rollback that needs no deploy.
# Brand spoofing is closed in all three modes: branding always comes from the
# verified session, never from the x-company-id header.
#
# NOTE for a new environment that already has traffic: app.devitrak.net calls
# this API and its source is not in this repo, so which routes it uses is not
# known here. Starting straight on enforce will refuse anything it sends that
# is not one of the four pre-login routes, and the failure is silent from the
# caller's side. If that applies to you, run `warn` for a day first, read the
# "nodemailer: unauthenticated notification allowed" lines, then come back to
# enforce. The code default is `warn`, so an environment deployed without this
# variable observes rather than refuses; this file is the target state, set
# deliberately.
NODEMAILER_AUTH_MODE=enforce

# Access control for /api/company/* (the Mongo company namespace). Same three
# modes as above, same default of `warn` in code:
#   enforce  401 to a caller with no valid session, except PUBLIC_ROUTES.
#   warn     log unauthenticated calls, block nothing.
#   off      disable the check entirely.
#
# Of the 18 routes in routes/company.js exactly ONE has ever checked anything,
# and the rest are not read-only: POST /provider-upload-document/:id uploads
# the posted file to S3 and pushes a record into Mongo, POST /new creates a
# company. So the target state is enforce.
#
# It is deliberately NOT set to enforce here yet, unlike the variable above.
# The client apps are not in this workspace, so which of those routes run
# before a session exists is unknown, and the exemption list in
# middlewares/companyAuth.js is seeded from route names, not from evidence.
# Run `warn` for a few days, read the "company: unauthenticated request
# allowed" lines, move anything legitimate into PUBLIC_ROUTES, and only then
# set enforce. Flipping it blind is how POST /api/db_company/delete-bulk-items
# spent three weeks answering 403 to a real user flow.
COMPANY_AUTH_MODE=warn

# Signed one-use email link for the dashboard's public /display-contracts page
# (consumer contract signing). off | warn | enforce — see
# middlewares/contractLinkAuth.js. Ship `warn`: emails sent before the deploy
# carry no token and must keep working. Switch to `enforce` 5 days after the
# deploy (the token's maximum life), once the dashboard sends `x-link-token`.
CONTRACT_LINK_MODE=warn

# Event invitations (/attendance-confirmation). off | warn | enforce — see
# middlewares/attendanceLinkAuth.js and controller/eventInvitation.js. In
# enforce, POST /api/school/event-invitations/response needs the link token and
# the generic consumer routes (POST /auth/new, PATCH /auth/:id,
# POST /auth/user-query, POST /db_consumer/new_consumer) refuse calls from the
# dashboard origin without a staff session. The consumer app is never affected.
# Switch 5 days after the dashboard ships the /send + /confirm flow.
ATTENDANCE_LINK_MODE=warn

# Anonymous GET /api/transaction/transaction (the dashboard's public /receipt page
# before receipts carried a signed token). warn | enforce — see routes/transaction.js.
# Ship `warn`: receipts already printed have a QR without token. Switch to `enforce`
# once the dashboard prints the signed QR (POST /api/transaction/receipt-link) and
# the receipts printed before that are no longer expected to be scanned.
RECEIPT_PUBLIC_READ_MODE=warn

# Runtime mode. Read by `process.env.NODE_ENV === "production"` checks; there is
# no default anywhere in the code, so leaving it unset is not "neutral" — it is
# the same as declaring the box non-production, and every one of those checks
# takes its development branch.
#
# What is currently gated on it, and what unset means on a production box:
#   controller/admin.js:64   session cookie `secure` flag -> false, so the JWT
#                            cookie is allowed over plain HTTP. IIS terminates
#                            TLS in front of Node, so the browser leg is still
#                            HTTPS; what is lost is the browser's refusal to
#                            ever replay that cookie on an http:// URL.
#   controller/admin.js:874  same flag on the logout/clear cookie.
#   helpers/logger.js:68     the winston Console transport stays attached, so
#                            every log line is also written to the nssm stdout
#                            file on top of logs/*.log.
#
# Setting it to `production` is NOT enough on its own: dotenv does not override
# a variable already present in the real environment, but the reverse is also
# true — a value here is only picked up by processes that actually read this
# repo's .env. On the production box the variable must be set on the Windows
# services themselves via `nssm set <service> AppEnvironmentExtra`, for all four
# Node services, not just the API. See DEPLOY.md, "NODE_ENV must be set on every
# Node service".
NODE_ENV=production

# Login lockout per account (FedRAMP AC-7). After LOGIN_MAX_ATTEMPTS failed
# passwords or MFA codes within LOGIN_ATTEMPT_WINDOW_S seconds, the account
# answers 429 for LOGIN_LOCKOUT_S seconds. Counter lives in Redis; without
# Redis the login is not blocked. See helpers/loginAttempts.js.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_S=900
LOGIN_LOCKOUT_S=1800

# Minimum length when a staff password is created or changed (FedRAMP IA-5).
# Login still accepts older, shorter passwords. Minimum allowed value: 8.
PASSWORD_MIN_LENGTH=12

# /api/db_company/consulting-company and /new_company without a staff session
# (the dashboard's company sign-up may call them before signing in). `warn`
# (default) allows and logs each call; `enforce` answers 401. Switch to enforce
# once the log shows no anonymous calls. See mysql/routes/company.js.
DB_COMPANY_PUBLIC_MODE=warn

# Consumer-app session token (helpers/consumerToken.js). Its own key, so a
# consumer token never verifies as a staff session. If unset, it is derived
# from SECRET_JWT_SEED (still distinct from the staff key). Set it explicitly
# in production so rotating one does not rotate the other.
CONSUMER_JWT_SECRET=
# Where the sign-in links sent to consumers point.
CONSUMER_APP_URL=https://app.devitrak.net
# Origins of the consumer app (comma-separated). The consumer token is only
# issued, redeemed and read on requests from these. Add the app's localhost
# for development, e.g. https://app.devitrak.net,http://localhost:3791
CONSUMER_ORIGINS=https://app.devitrak.net
# Consumer-token check on the routes the consumer app calls (phase C,
# middlewares/consumerTokenGate.js). `warn` (default) logs what enforce would
# refuse and lets it through; `enforce` answers 401/403; `off` disables it.
# Read the log ("consumer token:") before switching to enforce.
CONSUMER_TOKEN_MODE=warn

# Sesión de staff en el servidor (FedRAMP A6, helpers/staffSession.js).
# Cada login abre una sesión (sid en el JWT y en Redis). checkTokenVersion
# rechaza el token de una sesión cerrada (logout, force-logout, login nuevo,
# reset de MFA) o sin actividad durante SESSION_IDLE_MINUTES.
#   warn    (por defecto) deja pasar y registra lo que habría rechazado
#   enforce responde 401 { sessionEnded: true, reason }
#   off     no comprueba nada
# Pasar a enforce no antes de 12 h después del despliegue: los tokens
# anteriores no llevan sid y en enforce se rechazan.
SESSION_MODE=warn
# Respaldo para la sesión abandonada; el dashboard cierra a los 15 min de
# inactividad del usuario. 0 desactiva la comprobación de inactividad.
SESSION_IDLE_MINUTES=30

# Dueño del recurso de Stripe en suscripciones y facturación (FedRAMP A8b,
# middlewares/requireStripeOwnership.js): la suscripción, el cliente, la cuenta
# conectada o el registro StripeCompany tiene que ser de la compañía del
# contexto. warn (por defecto) registra lo ajeno y deja pasar; enforce responde
# 404; off no comprueba. Revisar con scripts/summarize-warn-logs.js antes de
# pasar a enforce.
STRIPE_OWNERSHIP_MODE=warn

# Claves `$...` (operadores de Mongo) en body o query: inyección NoSQL (SI-10,
# middlewares/rejectMongoOperators.js). warn (por defecto) registra y deja
# pasar; enforce responde 400; off no comprueba. Revisar con
# scripts/summarize-warn-logs.js antes de pasar a enforce.
NOSQL_INPUT_MODE=warn
# authorizePermission (SQL): company_id del body/params/query distinto del
# header s-company-lq. warn (por defecto) registra y sigue; enforce responde
# 403; off no compara. Revisar con scripts/summarize-warn-logs.js.
COMPANY_CONTEXT_MODE=warn

# RAM y CPU de cada proceso Node, una línea JSON por muestra en
# logs/runtime-metrics.log (A10, helpers/runtimeMetrics.js). Lo resume
# scripts/summarize-ram.js. 0 lo apaga.
RUNTIME_METRICS_INTERVAL_SEC=60

# Planes de suscripción (2026-11-06; constants/subscriptionPlans.js).
# Topes de staff e inventario: warn (por defecto) deja pasar y registra lo que
# rechazaría ("plan limits: would refuse ..."); enforce responde 403
# PLAN_LIMIT_REACHED; off no comprueba. Antes de enforce:
# node scripts/plan-usage-report.js (compañías que ya superan Free).
PLAN_LIMITS_MODE=warn
# Stripe: precios de "Devitrak Pro" ($320/mes, $3,000/año) y el secreto del
# endpoint POST /api/webhooks/stripe (Dashboard de Stripe > Webhooks). Sin
# precio, Checkout responde 503; sin secreto, el webhook responde 503.
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_WEBHOOK_SECRET=
# Días de prueba de Pro (una vez por compañía). 0 la quita.
SUBSCRIPTION_TRIAL_DAYS=30

# Cuentas de staff inactivas (AC-2(3), 2026-11-09; scheduler/staffInactivity.js).
# Barrido diario a las 03:15. warn (por defecto) solo registra a quién
# desactivaría ("staff inactivity: would disable account ..."); enforce la
# desactiva (el login responde 403 accountDisabled); off no hace nada.
# Antes de enforce: node scripts/staff-inactivity.js --report.
STAFF_INACTIVITY_MODE=warn
STAFF_INACTIVITY_DAYS=90
# La inactividad cuenta desde esta fecha como mínimo (YYYY-MM-DD; por defecto
# 2026-11-09, cuando se empezó a guardar el último login): nadie se desactiva
# antes de SINCE + DAYS.
STAFF_INACTIVITY_SINCE=2026-11-09
# Emails que nunca se desactivan (cuentas de emergencia), separados por comas.
STAFF_INACTIVITY_EXEMPT=
