<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <staticContent>
      <!-- Set caching for static content -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" />
    </staticContent>
    <caching>
      <profiles>
        <!-- Define caching profiles -->
        <add extension=".js" policy="CacheForTimePeriod" duration="00:00:00" />
        <add extension=".css" policy="CacheUntilChange" />
      </profiles>
    </caching>
    <!-- 413 fix here too -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>

    <serverRuntime uploadReadAheadSize="1048576" />

  </system.webServer>
</configuration>