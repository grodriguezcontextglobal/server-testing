<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- If this site is ONLY a reverse-proxy for /api/*, route everything through -->
    <rewrite>
      <rules>
        <rule name="ProxyAllToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:34001/{R:1}" logRewrittenUrl="true" />
          <serverVariables>
            <set name="HTTP_X_Forwarded_Proto" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- 413 fix here too -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>

    <serverRuntime uploadReadAheadSize="1048576" />

  </system.webServer>
</configuration>